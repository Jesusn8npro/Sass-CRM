OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# Kill switch del bot. Default: el bot arranca con el server.
# Si querés trabajar SOLO en la UI sin arrancar Baileys (típico en
# dev local cuando producción ya está conectada al mismo número y no
# querés que se kickeen mutuamente con código 440), poné false.
# BOT_ENABLED=false
# Opcional — solo si activás voz por cuenta (responder con notas de voz):
ELEVENLABS_API_KEY=sk_...

# Opcional — URL pública del panel para webhooks de Vapi (transcripción
# + grabación). En dev local: ngrok / cloudflared.
# VAPI_PUBLIC_URL=https://tu-dominio.com

# ----- Vapi credenciales del SISTEMA (modelo SaaS) -----
# Por default, todas las cuentas de tus clientes usan ESTAS keys.
# Sus assistants se crean en TU cuenta de Vapi, las llamadas se cobran
# a TU billing. Si una cuenta puntual quiere usar otra cuenta de Vapi,
# puede pegar sus propias keys en /configuracion (override por cuenta).
#
# Conseguir en https://dashboard.vapi.ai → Settings → API Keys
VAPI_API_KEY=
# Public key — safe-to-expose, usada por @vapi-ai/web en el browser
# para test con micrófono.
VAPI_PUBLIC_KEY=
# Phone Number ID — el UUID del número comprado/importado en Vapi
# (NO es tu número celular).
VAPI_PHONE_NUMBER_ID=

# ----- Emails transaccionales (Resend) -----
# Si está set, el SaaS manda emails de bienvenida, recibos de pago,
# alertas de pago fallido y de WhatsApp desconectado. Si NO está set,
# todo el flujo sigue funcionando — los disparadores se vuelven no-op
# y solo loguean "sin_api_key" en pino. Útil para dev local.
# Sacar API key gratis (3K emails/mes) en https://resend.com
RESEND_API_KEY=re_...
# Email "from" — debe ser un dominio verificado en Resend.
RESEND_FROM=Sass-CRM <hola@sass-crm.com>
# URL base del panel — usada en CTAs de los emails (botones a /app/...).
# En prod: https://tu-dominio.com. En dev: http://localhost:3000.
APP_URL=http://localhost:3000

# Supabase (Auth + multi-tenant + DB + Storage)
# URL pública del proyecto (segura para exponer al cliente)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxx.supabase.co

# ----- Claves NUEVAS (formato sb_*) -----
# Si tu proyecto tiene "Legacy API keys" deshabilitadas (default en
# proyectos creados después de mediados 2026), usá ESTE formato.

# Publishable (rol anon) — segura para exponer al browser, RLS protege.
# Dashboard → Settings → API Keys → Publishable keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Secret (rol service_role) — SOLO server-side. NUNCA con prefijo
# NEXT_PUBLIC_. Bypassea RLS, da acceso admin total.
# Dashboard → Settings → API Keys → Secret keys → "Reveal".
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ============================================================
# IA · Generación de imágenes (Nano Banana / Gemini 2.5 Flash Image)
# ============================================================
# Dashboard: https://aistudio.google.com/apikey
# Costo aprox: $0.039 por imagen. 1 crédito por imagen al user.
GEMINI_API_KEY=

# ============================================================
# IA · Lead-gen (Apify — Google Maps + emails)
# ============================================================
# Token personal del operador del SaaS. Vos pagás Apify y le facturás
# créditos al user. Conseguilo en:
# https://console.apify.com/account/integrations
APIFY_TOKEN=

# Secret HMAC para verificar los webhooks que Apify nos pega cuando
# un job termina. Generá uno random (ej: openssl rand -hex 32) y
# pasalo también al crear el webhook desde el código.
APIFY_WEBHOOK_SECRET=

# URL pública del Next.js — necesaria para que Apify sepa a dónde
# pegarnos cuando termina un run. En prod: https://tu-dominio.com
# En dev local con ngrok/cloudflared: la URL pública del túnel.
PUBLIC_URL=http://localhost:3000
BOT_ENABLED=false

# ============================================================
# Outreach Pipeline — Cold Calling + Cold Email
# ============================================================
# TEST_MODE=true  → redirige TODAS las llamadas a TEST_PHONE_NUMBER
#                   y todos los emails de outreach a TEST_EMAIL.
#                   Usar siempre en dev para no llamar a negocios reales.
# TEST_MODE=false → llamadas y emails van al lead real (producción).
OUTREACH_TEST_MODE=true
OUTREACH_TEST_PHONE=+1234567890
OUTREACH_TEST_EMAIL=tu@email.com
# Nombre que aparece como firma en los cold emails (ej: "Ryan", "El equipo de ProspectAI")
OUTREACH_AGENT_NAME=El equipo
# Signing secret del webhook de Resend para eventos de entrega (delivered, bounced, spam).
# Obtener en: Resend Dashboard → Webhooks → tu webhook → Signing Secret
# Empieza con "whsec_". Si no se configura, se acepta sin verificar (solo dev).
RESEND_WEBHOOK_SECRET=whsec_...
# Assistant Vapi dedicado para llamadas en frío (system prompt con call-script.md).
# Si no se setea, usa el assistant default de cada cuenta.
# Crear en https://dashboard.vapi.ai → Assistants → copiar el ID.
OUTREACH_ASSISTANT_ID=
# Máximo de llamadas por hora por cuenta (evita flag de spam en carriers)
OUTREACH_MAX_LLAMADAS_POR_HORA=10

# ============================================================
# Cron interno — reportes semanales por email + reporte diario admin
# ============================================================
# Secret usado para autorizar POST /api/cron/* y POST /api/admin/* desde
# un cron externo (Vercel Cron, EasyCron, GitHub Actions, Easy Panel
# cron) o desde el scheduler interno que corre dentro del bot. Si está
# vacío, los endpoints devuelven error. Generá uno random:
#   openssl rand -hex 32
CRON_SECRET=secreto_largo_aleatorio

# Habilita el scheduler interno que cada lunes 9–12 LOCAL del servidor
# pega al endpoint /api/cron/reportes-semanales. Sólo prendelo en
# producción — en dev local generaría emails reales si tenés la
# RESEND_API_KEY seteada.
REPORTES_SEMANALES_HABILITADO=false

# ============================================================
# Super-Admin del SaaS (Fase 1)
# ============================================================
# El super-admin se identifica por su email (en sesión Supabase) y
# por su teléfono WhatsApp (en mensajes entrantes al bot). Ambos se
# leen de la tabla `public.super_admins` — no de env vars. Para
# agregar un nuevo super-admin, insertarlo en esa tabla.
#
# Seed inicial (migración 07): acordeon91@gmail.com / +573123790071
# Panel: /admin · Comandos WhatsApp: /reporte, /usuarios, /cuentas,
# /ingresos, /alertas, /ayuda
#
# (Coexiste con ADMIN_EMAIL legacy del panel /app/admin si existe.)
